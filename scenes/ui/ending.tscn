bg_color = Color(0.055, 0.38, 0.46, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.25, 0.9, 1, 1)

[node name="Ending" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ending")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.012, 0.026, 0.035, 1)

[node name="SignalBand" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 110.0
offset_bottom = 116.0
grow_horizontal = 2
color = Color(0.04, 0.72, 0.42, 0.72)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -205.0
offset_right = 300.0
offset_bottom = 205.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Panel" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(600, 235)
layout_mode = 2
theme_override_styles/panel = SubResource("Style_panel")

[node name="Message" type="VBoxContainer" parent="Layout/Panel"]
layout_mode = 2
theme_override_constants/separation = 13
alignment = 1

[node name="Title" type="Label" parent="Layout/Panel/Message"]
layout_mode = 2
theme_override_colors/font_color = Color(0.86, 1, 0.93, 1)
theme_override_font_sizes/font_size = 42
text = "PROJECT LUMEN"
horizontal_alignment = 1

[node name="Restored" type="Label" parent="Layout/Panel/Message"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.95, 0.56, 1)
theme_override_font_sizes/font_size = 23
text = "OBSERVATION NETWORK RESTORED"
horizontal_alignment = 1

[node name="Complete" type="Label" parent="Layout/Panel/Message"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.68, 0.72, 1)
theme_override_font_sizes/font_size = 17
text = "Prototype sequence complete."
horizontal_alignment = 1

[node name="RevisitButton" type="Button" parent="Layout"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("Style_button")
theme_override_styles/hover = SubResource("Style_button_hover")
theme_override_styles/pressed = SubResource("Style_button_hover")
theme_override_styles/focus = SubResource("Style_button_hover")
