[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/ending.gd" id="1_ending"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.025, 0.065, 0.075, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
